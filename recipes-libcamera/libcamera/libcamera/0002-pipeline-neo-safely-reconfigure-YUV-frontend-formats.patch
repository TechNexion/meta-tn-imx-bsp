From 9c02c689c00810ee35a513660e844b60855d7acd Mon Sep 17 00:00:00 2001
From: Nian Yang <nian.yang@technexion.com>
Date: Fri, 26 Jun 2026 05:45:59 +0000
Subject: [PATCH] pipeline: neo: safely reconfigure YUV frontend formats

After exposing all YUV sensor resolutions, requests for smaller sizes could
configure the ISI video node to the requested size while the shared frontend
graph remained at the preconfigured maximum size. This caused stream start
failures, or left the sensor entity reporting the old maximum format.

Upstream-Status: Pending

---
 .../pipeline/nxp/neo/neo_pipeline.cpp         | 42 +++++++++++++++++--
 1 file changed, 38 insertions(+), 4 deletions(-)

diff --git a/src/libcamera/pipeline/nxp/neo/neo_pipeline.cpp b/src/libcamera/pipeline/nxp/neo/neo_pipeline.cpp
index cf9f0635..296e74b7 100644
--- a/src/libcamera/pipeline/nxp/neo/neo_pipeline.cpp
+++ b/src/libcamera/pipeline/nxp/neo/neo_pipeline.cpp
@@ -299,6 +299,7 @@ private:
 	int configureFrontEndStream(const std::vector<CameraMediaStream::StreamLink> &streamLinks,
 				    V4L2SubdeviceFormat &sdFormat);
 	int configureFrontEndLinks() const;
+	bool canReconfigureFrontEndSafely();

 	int configureRaw(CameraConfiguration *c);
 	int configureYuv(CameraConfiguration *c);
@@ -2481,6 +2482,27 @@ int NxpNeoCameraData::configureFrontEndLinks() const
 	return 0;
 }

+bool NxpNeoCameraData::canReconfigureFrontEndSafely()
+{
+	if (!multiCamera())
+		return true;
+
+	/*
+	 * In multi-camera mode the frontend graph is shared by cameras behind
+	 * the same frontend media device. Reconfiguring it is only safe while
+	 * this is the only camera currently acquired by this pipeline handler.
+	 */
+	if (pipe()->useCount() <= 1)
+		return true;
+
+	LOG(NxpNeoPipe, Warning)
+		<< "Cannot reconfigure frontend for " << cameraName()
+		<< " while other cameras are acquired"
+		<< " useCount " << pipe()->useCount();
+
+	return false;
+}
+
 int NxpNeoCameraData::configureRaw(CameraConfiguration *c)
 {
 	NxpNeoCameraConfiguration *config =
@@ -2666,14 +2688,26 @@ int NxpNeoCameraData::configureYuv(CameraConfiguration *c)
 	 * configured without multi-camera consideration. The pipe subdevice
 	 * format comes from the front-end configuration.
 	 */
-	if (!multiCamera()) {
-		V4L2SubdeviceFormat sensorFormat = config->sensorFormat();
+	V4L2SubdeviceFormat sensorFormat = config->sensorFormat();
+	if (canReconfigureFrontEndSafely()) {
 		ret = configureFrontEndFormat(sensorFormat,
-					      config->combinedTransform());
+						  config->combinedTransform());
 		if (ret)
 			return ret;
-	}
+	} else {
+		const V4L2SubdeviceFormat &currentFormat =
+			pipesSubDevFormats_[StreamTypeImage0];

+		if (sensorFormat.size != currentFormat.size ||
+			sensorFormat.code != currentFormat.code) {
+			LOG(NxpNeoPipe, Error)
+				<< "Requested frontend format " << sensorFormat.toString()
+				<< " does not match active frontend format "
+				<< currentFormat.toString();
+
+			return -EINVAL;
+		}
+	}
 	/* \todo support multistream */
 	ISIPipe *pipe = pipes_.at(StreamTypeImage0);
 	StreamConfiguration &streamConfig = c->at(0);
