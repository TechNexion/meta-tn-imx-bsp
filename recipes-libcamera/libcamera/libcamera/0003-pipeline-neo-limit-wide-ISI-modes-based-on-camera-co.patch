From 932fc4d7647aa1700f2b1e636db17f0efd9a4fbd Mon Sep 17 00:00:00 2001
From: Nian Yang <nian.yang@technexion.com>
Date: Thu, 2 Jul 2026 13:42:02 +0800
Subject: [PATCH] pipeline: neo: limit wide ISI modes based on camera count

ISI channels can handle widths up to 2048 pixels with a single pipe.
Filter the advertised camera formats according to the number of detected
cameras and available ISI pipes. The number of cameras allowed to keep
wide modes is calculated from the spare pipe count:

    wide cameras = ISI pipe count - detected camera count

This keeps one ISI pipe available per camera while
still allowing wider modes when the topology has enough spare pipes.

Upstream-Status: Pending
---
 .../pipeline/nxp/neo/front_end_isi.cpp        | 71 ++++++++++++++++++-
 1 file changed, 70 insertions(+), 1 deletion(-)

diff --git a/src/libcamera/pipeline/nxp/neo/front_end_isi.cpp b/src/libcamera/pipeline/nxp/neo/front_end_isi.cpp
index bb49886f..d815ec0a 100644
--- a/src/libcamera/pipeline/nxp/neo/front_end_isi.cpp
+++ b/src/libcamera/pipeline/nxp/neo/front_end_isi.cpp
@@ -65,6 +65,9 @@ public:
 		MediaEntity *sensorEntity;
 		ISIDevice *isiDevice;
 		PadStreamsMap *deviceStreamMap;
+		unsigned int cameraIndex;
+		unsigned int cameraCount;
+		unsigned int maxImage0Width;
 	};
 	int init(const FrontEndHandler::MatchParams &matchParams,
 		 const InitParams &initParams);
@@ -128,6 +131,33 @@ private:

 namespace {

+void filterFormatsByMaxWidth(FrontEndCamera::Formats *formats,
+			     unsigned int maxWidth)
+{
+	std::map<Size, std::vector<unsigned int>> filteredSizeToCodes;
+	std::map<unsigned int, std::vector<Size>> filteredCodeToSizes;
+
+	for (const auto &[size, codes] : formats->sizeMbusCodesMap) {
+		if (size.width > maxWidth)
+			continue;
+
+		filteredSizeToCodes[size] = codes;
+		for (unsigned int code : codes)
+			filteredCodeToSizes[code].push_back(size);
+	}
+
+	formats->sizeMbusCodesMap = std::move(filteredSizeToCodes);
+	formats->mbusCodeSizesMap = std::move(filteredCodeToSizes);
+
+	for (auto it = formats->mbusCodePixelFormatsMap.begin();
+	     it != formats->mbusCodePixelFormatsMap.end();) {
+		if (!formats->mbusCodeSizesMap.count(it->first))
+			it = formats->mbusCodePixelFormatsMap.erase(it);
+		else
+			++it;
+	}
+}
+
 /**
  * \brief Get the sizes supported by a camera for a mbus code
  * \param[in] sensor The camera sensor
@@ -374,6 +404,21 @@ int FrontEndCameraIsi::init(const FrontEndHandler::MatchParams &matchParams,
 	} else {
 		rawCamera_ = true;
 	}
+
+	/*
+	 * ISI pipes can process up to kUnchainedWidthMax with one pipe. Wider
+	 * resolutions require one extra adjacent pipe. When many cameras are
+	 * connected, keep wide resolutions only for the first cameras that can
+	 * be backed by an extra pipe, and force the remaining cameras to expose
+	 * only unchained resolutions.
+	 */
+	filterFormatsByMaxWidth(&formats_, initParams.maxImage0Width);
+	if (formats_.sizeMbusCodesMap.empty()) {
+		LOG(NxpNeoFeIsi, Error)
+			<< "No supported format left after ISI pipe policy filtering";
+		return -EINVAL;
+	}
+
 	ret = populateVideoFormats();
 	if (ret)
 		return ret;
@@ -916,7 +961,23 @@ bool FrontEndHandlerIsi::match([[maybe_unused]] const MatchParams &params)
 	 * Go through every detected sensor entity and create its associated
 	 * FrontEndCamera object.
 	 */
-	for (const auto entity : entities) {
+	const unsigned int cameraCount = entities.size();
+	const unsigned int isiPipeCount = isiDevice_->crossbarSourcePads();
+	const unsigned int wideCameraCount =
+		cameraCount < isiPipeCount ? isiPipeCount - cameraCount : 0;
+
+	LOG(NxpNeoFeIsi, Debug)
+		<< "Detected " << cameraCount << " cameras, "
+		<< isiPipeCount << " ISI pipes, allowing "
+		<< wideCameraCount << " cameras to use chained-width modes";
+
+	for (const auto &[cameraIndex, entity] : utils::enumerate(entities)) {
+		const unsigned int index = static_cast<unsigned int>(cameraIndex);
+		const bool allowWide = index < wideCameraCount;
+		const unsigned int maxImage0Width =
+			allowWide ? ISIPipe::kChainedWidthMax
+				  : ISIPipe::kUnchainedWidthMax;
+
 		std::unique_ptr<FrontEndCameraIsi> feCamera =
 			std::make_unique<FrontEndCameraIsi>();
 		FrontEndCameraIsi::InitParams initParams = {
@@ -924,7 +985,15 @@ bool FrontEndHandlerIsi::match([[maybe_unused]] const MatchParams &params)
 			.sensorEntity = entity,
 			.isiDevice = isiDevice_.get(),
 			.deviceStreamMap = &deviceStreamMap,
+			.cameraIndex = index,
+			.cameraCount = cameraCount,
+			.maxImage0Width = maxImage0Width,
 		};
+
+		LOG(NxpNeoFeIsi, Debug)
+			<< "Camera index " << index
+			<< " max Image0 width " << maxImage0Width;
+
 		int ret = feCamera->init(params, initParams);
 		if (ret)
 			continue;
